# Entornos virtuales
.venv/
.venv_scraping/
venv/
venv_scraping/

# Caché de Python
__pycache__/
*.pyc

# VS Code settings
.vscode/

# Carpeta de instrucciones local
.github.ignore/

# Archivos del sistema
.DS_Store
Thumbs.db

# Logs
*.log

# Datos crudos (encuestas / sensibles)
data/raw/

# Outputs crudos de scraping (no versionar)
data/external/

# Cookies / credenciales 
cookies_*.json
.env
.env.*

# Outputs generados: ignorar todo por defecto
outputs/*
artifacts/

# Permitir solo tablas finales usadas por Streamlit
!outputs/latest/
!outputs/latest/tables/
!outputs/latest/tables/*.csv

# Permitir análisis de texto final si el dashboard lo usa
!outputs/text_analysis/
!outputs/text_analysis/case1_es/
!outputs/text_analysis/case1_es/news_sentiment_scored.csv
!outputs/text_analysis/case2_en/
!outputs/text_analysis/case2_en/news_sentiment_scored.csv
!outputs/text_analysis/case3_ec_media/
!outputs/text_analysis/case3_ec_media/news_sentiment_scored.csv

# Datos procesados: ignorar todo por defecto
data/processed/*

# Permitir dataset final no sensible usado por el dashboard
!data/processed/encuestas/
!data/processed/encuestas/model_ready.csv

# Backend: ignorar todo por defecto
backend/*



# Permitir artefactos públicos usados por Streamlit
!backend/public/
!backend/public/surveys/
!backend/public/surveys/tables/
!backend/public/surveys/tables/*.csv
!backend/public/surveys/MANIFEST.json
!backend/public/surveys/MANIFEST.txt

# Permitir JSON finales usados por Streamlit
!outputs/latest/tables/*.json

# Permitir modelos finales usados por el simulador, si están dentro de outputs/latest/models
!outputs/latest/models/
!outputs/latest/models/*.joblib

# Permitir joblib si quedó guardado dentro de tables
!outputs/latest/tables/*.joblib

# Streamlit secrets
.streamlit/secrets.toml

# Permitir JSON finales usados por Streamlit
!outputs/latest/tables/*.json

# Permitir modelos finales usados por Streamlit
!outputs/latest/models/
!outputs/latest/models/*.joblib
!outputs/latest/tables/*.joblib

# Permitir JSON finales usados por Streamlit
!outputs/latest/tables/*.json

# Permitir modelo final del simulador usado por Streamlit
!outputs/latest/models_dashboard/
!outputs/latest/models_dashboard/*.joblib
!outputs/latest/models_dashboard/*.json